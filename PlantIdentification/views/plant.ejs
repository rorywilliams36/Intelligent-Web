<!DOCTYPE html>
<html>
    <head>
        <%- include('./partial/head.ejs'); %>
        <title><% title %></title>

    <header>
        <%- include('./partial/header.ejs'); %>
    </header>

    <body>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <div class="row">
            <div class="card col-xl-6 col-lg-6 col-md-8 col-sm-12 mx-auto"><img class="card-img-top w-100 d-block p-3" alt="green succulent in teal ceramic vase" src="https://i.imgur.com/9K71qcB.png">
                <div class="card-body text-center">
                    <h4 class="text-bg-primary py-2 rounded"><strong>PlantName</strong></h4>
                    <div class="container">
                        <div class="row">
                            <div class="col-md-6"><i class="far fa-clock"></i><span style="margin-left: 0.2em;">Date</span></div>
                            <div class="col"><i class="far fa-user"></i><span style="margin-left: 0.2em;">UserName</span></div>
                        </div>
                        <div class="row">
                            <div class="col-md-6"><i class="far fa-chart-bar"></i><span style="margin-left: 0.2em;">Size</span></div>
                            <div class="col-md-6"><i class="far fa-map"></i><span style="margin-left: 0.2em;">Location</span></div>
                        </div>
                    </div>
                    <p class="card-text" style="margin-top: 1em;">Nullam id dolor id nibh ultricies vehicula ut id elit. Cras justo odio, dapibus ac facilisis in, egestas eget quam. Donec id elit non mi porta gravida at eget metus.</p>
                </div>
            </div>
        </div>
    </body>

    <footer>
        <%- include('./partial/footer.ejs'); %>
    </footer>
</html>
