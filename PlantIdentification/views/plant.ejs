<!DOCTYPE html>
<html>
    <head>
        <%- include('./partial/head.ejs'); %>
        <title><% title %></title>

    <header>
        <%- include('./partial/header.ejs'); %>
    </header>

    <body>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <div class="row">
            <div class="card col-xl-6 col-lg-6 col-md-8 col-sm-12 mx-auto">
                <%
                    // Displays image from database
                    // If no image is found uses the defaultviews
                    plant_img = "https://media.istockphoto.com/id/658291850/photo/young-plant-growing-in-sunlight.jpg?s=612x612&w=0&k=20&c=ZH9gmP8dLhwNaWuVbtBz99Fkybg_B0Uanw88QXSdMnY=";
                    if (data.Img) { plant_img = '\\' + data.Img; }
                    loc_array = data.Location.split(",");
                    long = loc_array[0].trim();
                    lat = loc_array[1].trim(); 
                    %>
                    <img class="rounded img-fluid d-block w-100 fit-cover mt-2" style="height: 400px;" src= "<%= plant_img %>" alt="Plant">
                    <div class="card-body">
                    <h4 class="text-bg-primary py-2 px-3 rounded"><strong><%= data.Plant_Name%></strong></h4>
                    <div class="container">
                        <!-- General -->
                        <div class="row mb-3">
                            <div class="col-md-6"><i class="fa-regular fa-calendar-days"></i><strong class="text-start" style="margin-left: 0.2em;">Date Seen: </strong><%= new Date(data.Date_Seen).toLocaleString('en-US', { weekday: 'short', month: 'short', day: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %></div>
                            <div class="col-md-6"><i class="fa-solid fa-user-tag"></i><strong class="text-start" style="margin-left: 0.2em;">User: </strong><%= data.Username %></div>
                        </div>
                        <div class="row mb-3">
                            <h5>Description</h5>
                            <div class="col-md-12"><%= data.Description %></div>
                        </div>
                        <h5>Location</h5>
                        <p><%= data.Location_Name %></p>
                        <div class="border border-2 border-primary rounded" id="map"></div>
                        <script>
                            var map = L.map('map').setView([<%= long %>, <%= lat %>], 14);
                            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                maxZoom: 19,
                                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                            }).addTo(map);
                            var circle = L.circle([<%= long %>, <%= lat %>], {
                                color: 'green',
                                fillColor: '#1e7d1e',
                                fillOpacity: 0.5,
                                radius: 200
                            }).addTo(map);
                        </script>
                        <br>
                        <!-- Plant Measurements -->
                        <div class="row mb-3">
                            <h5>Plant Size</h5>
                            <div class="col-md-6"><i class="fa-solid fa-up-down"></i><strong class="text-start" style="margin-left: 0.2em;">Height: </strong><%= data.Height %>m</div>
                            <div class="col-md-6"><i class="fa-solid fa-arrows-left-right"></i><strong class="text-start" style="margin-left: 0.2em;">Spread: </strong><%= data.Spread %>m</div>
                        </div>
                        <!-- Plant Characteristics -->
                        <div class="row mb-3">
                            <h5>Plant Characteristics</h5>
                            <div class="col-md-6"><i class="fa-solid fa-spa"></i><strong class="text-start" style="margin-left: 0.2em;">Does the plant flower? </strong><%= data.Flowers %></div>
                            <div class="col-md-6"><i class="fa-solid fa-leaf"></i><strong class="text-start" style="margin-left: 0.2em;">Does the plant have leaves? </strong><%= data.Leaves %></div>
                            <div class="col-md-6"><i class="fa-solid fa-apple-whole"></i><strong class="text-start" style="margin-left: 0.2em;">Type of Fruit: </strong><%= data.Fruit_Seeds %></div>
                            <div class="col-md-6"><i class="fa-solid fa-cloud-sun"></i><strong class="text-start" style="margin-left: 0.2em;">Sun Exposure: </strong><%= data.Sun_Exposure %></div>
                            <div class="col-md-6"><i class="fa-solid fa-palette"></i><strong class="text-start" style="margin-left: 0.2em;">Flower Colour: </strong><%= data.Flower_Colour %></div>
                        </div>

                        <!-- DBPedia Identification -->
                        <div class="card mt-3 mb-3">
                            <div class="card-body" style="background: #f0ffee;">
                                <h4 class="card-title">Identification</h4>
                                <h6 class="text-muted card-subtitle mb-2">Status: Unknown</h6>
                                <p class="card-text">No information could be found for this plant.</p><a class="card-link" href="#">Link</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Optional JavaScript -->
        <!-- jQuery first, then Popper.js, then Bootstrap JS -->
        <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js" integrity="sha384-DfXdz2htPH0lsSSs5nCTpuj/zy4C+OGpamoFVy38MVBnE+IbbVYUew+OrCXaRkfj" crossorigin="anonymous"></script>
        <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
        <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js" integrity="sha384-OgVRvuATP1z7JjHLkuOU7Xw704+h835Lr+6QL9UvYjZE3Ipu6Tp75j7Bh/kR0JKI" crossorigin="anonymous"></script>
    </body>

    <footer>
        <%- include('./partial/footer.ejs'); %>
    </footer>
</html>
