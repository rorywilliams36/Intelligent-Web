<!DOCTYPE html>
<html>
    <head>
        <%- include('./partial/head.ejs'); %>
        <title><% title %></title>

    <header>
        <%- include('./partial/header.ejs'); %>
    </header>

    <body>
        <div class="container py-4 py-xl-5">
            <div class="row mb-5">
                <div class="col-md-8 col-xl-6 text-center mx-auto">
                    <h2>Plant Finder</h2>
                    <p class="w-lg-50">View Posts from the Community</p>
                </div>
            </div>
            <div class="row gy-4 row-cols-1 row-cols-md-2 row-cols-xl-3">
                <% for (let i = 0; i < 5; i++) { %>
                <div class="col">
                    <div><img class="rounded img-fluid d-block w-100 fit-cover" style="height: 200px;" src="https://cdn.bootstrapstudio.io/placeholders/1400x800.png">
                        <div class="text-center text-bg-light py-4" style="padding-top: 0px;margin-top: -1px;padding-bottom: 0px;">
                            <h4 class="text-bg-primary" style="padding-bottom: 11px;padding-top: 10px;font-weight: bold;">Plant Name</h4>
                            <div class="row">
                                <div class="col"><i class="far fa-map"></i><strong class="text-start" style="margin-left: 0.2em;">Location</strong></div>
                                <div class="col"><i class="far fa-clock"></i><strong class="text-start" style="margin-left: 0.2em;">Date</strong></div>
                                <div class="col"><i class="far fa-user"></i><strong class="text-start" style="margin-left: 0.2em;">John Doe</strong></div>
                            </div>
                            <p></p><a class="btn btn-primary" type="button" style="padding-right: 28px;padding-left: 30px;" href="/plant">View Post</a>
                        </div>
                    </div>
                </div>
                <% } %>
            </div>
        </div>
        <script src="assets/bootstrap/js/bootstrap.min.js"></script>
    </body>

    <footer>
        <%- include('./partial/footer.ejs'); %>
    </footer>
</html>
