<!DOCTYPE html>
<html>
    <head>
        <%- include('./partial/head.ejs'); %>
        <title><% title %></title>

    <header>
        <%- include('./partial/header.ejs'); %>
    </header>

    <body>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <div class="row d-flex align-content-center mx-1">
            <% for (let i = 0; i < 20; i++) { %>
            <div class="col-xl-3 col-lg-6 col-md-6 card mb-2">
                <div class="row my-3">
                    <div class="col">
                        <!-- Plant Image-->
                        <img class="card-img-topimg-fluid h-auto mw-100 rounded mx-auto d-block" src="https://st.depositphotos.com/2632165/4026/i/450/depositphotos_40264933-stock-photo-young-plant.jpg" alt="Plant Image">
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <p class="card-title text-center display-6">Poison Ivy</p>
                    </div>
                </div>
                <div class="row border mx-1 mb-1">
                    <p><strong>Date: </strong> 10th February</p>
                </div>
                <div class="row border mx-1 mb-1">
                    <p><strong>Discovered by: </strong> Rory</p>
                </div>
                <div class="row border mx-1 mb-1">
                    <p><strong>Location: </strong> <a href="https://www.google.com/maps/place/Sheffield/data=!4m2!3m1!1s0x48790aa9fae8be15:0x3e2827f5af06b078?sa=X&ved=2ahUKEwjAnKHy-9-EAxXsUEEAHVgRBdUQ8gF6BAgSEAA">Sheffield, GB</a></p>
                </div>
                <div class="row mx-1 mb-1">
                    <a href="/plant" class="btn btn-primary">View</a>
                </div>
            </div>
            <% } %>
        </div>

    </body>

    <footer>
        <%- include('./partial/footer.ejs'); %>
    </footer>
</html>
