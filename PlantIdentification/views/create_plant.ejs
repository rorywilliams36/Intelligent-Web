<!DOCTYPE html>
<html>
    <head>
        <%- include('./partial/head.ejs'); %>
        <title><% title %></title>

    <header>
        <%- include('./partial/header.ejs'); %>
    </header>

    <body>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <form class="card col-md-6 mb-5 mx-auto" action="/submit-plant" method="post" enctype="multipart/form-data">
            <div class="form-row">
                <div class="form-group">
                    <label for="Plant_Name"></label>
                    <input type="text" class="form-control" name="Plant_Name" id="Plant_Name" placeholder="Plant Name">
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="Username"></label>
                    <input type="text" class="form-control" name="Username" id="Username" placeholder="Username">
                </div>
            </div>
            <div class="form-group d-inline-flex cols-md-6 input-group mb-3">
                <label for="Location"></label>
                <input type="text" class="form-control" placeholder="Location" name="Location" id="Location">
                <button type="button" class="btn btn-info btn-sm" onclick="getLocation()">Get Location</button>
            </div>
            <div class="form-group">
                <label for="Date_Seen">Date Seen</label>
                <input type="text" class="form-control" name="Date_Seen" id="Date_Seen" placeholder="YYYY-MM-DD" value="<%= new Date().toISOString().split('T')[0] %>">
            </div>
            </div>
            <div class="form-group col-md-6">
                <label for="Height"></label>
                <input type="number" class="form-control" name="Height" id="Height" placeholder="Height (m)">
            </div>
            <div class="form-group col-md-6">
                <label for="Spread"></label>
                <input type="number" class="form-control" name="Spread" id="Spread" placeholder="Spread (m)">
            </div>
            <div class="d-inline-flex">
                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="Flowers" id="Flowers" onclick="checkFlowers()">
                        <label class="form-check-label" for="Flowers">
                            Flowers?
                        </label>
                    </div>
                    <div style="display: None" id="colourText">
                        <label for="Flower_Colour"></label>
                        <textarea class="form-control" id="Flower_Colour" placeholder="Flower Colour" name="Flower_Colour" rows="1"></textarea>
                    </div>
                </div>
                <div class="form-group">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="Leaves" id="Leaves">
                        <label class="form-check-label" for="Leaves">
                            Leaves?
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <select class="form-select" aria-label="Seeds and Fruits Select" name="Fruit_Seeds" id="Fruit_Seeds">
                        <option value="Fruits and Seeds">Seeds and Fruits</option>
                        <option value="Fruit Only">Fruits</option>
                        <option value="Seeds Only">Seeds</option>
                        <option value="None">None</option>
                    </select>
                </div>
                <div class="form-group">
                    <select class="form-select" aria-label="Sun Exposure Select" name="Sun_Exposure" id="Sun_Exposure">
                        <option value="Full Sun">Full Sun</option>
                        <option value="Partial Shade">Partial Shade</option>
                        <option value="Full Shade">Full Shade</option>
                        <option value="N/a">N/a</option>
                    </select>
                </div>
            </div>
            <div class="form-group">
                <label for="Description">Description</label>
                <textarea class="form-control" name="Description" id="Description" rows="3"></textarea>
            </div>
            <div class="form-group">
                <label for="image">Choose an image (Optional)</label><br><br>
                <input type="file" id="img" name="Img" accept="image/*">
            </div>
            <div class="form-check">
                <label class="form-check-label" for="Status">
                <input class="form-check-input" type="checkbox" name="Status" id="Status">
                    Status
                </label>
            </div>
            <button type="submit" class="btn btn-primary" >Submit Plant</button>
        </form>
    </body>

    <footer>
        <%- include('./partial/footer.ejs'); %>
    </footer>
</html>

<script>
    // Function to display a text field for flower colour
    function checkFlowers() {
        let check = document.getElementById('Flowers');
        let colour = document.getElementById('colourText')
        if (check.checked) {
            colour.style.display = "block";
        }
        else {
            colour.style.display = "none";
        }
    }
</script>
<script>
    // Function to get geolocation of user
    function getLocation() {
        let locationField = document.getElementById('Location');
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(pos) {
                    let latitude = pos.coords.latitude;
                    let longitude = pos.coords.longitude;
                    locationField.value = `${latitude}, ${longitude}`;
                },
                function(error) {
                    console.log('Error occurred in getting position')
                });
        }
        else {
            window.alert('Geolocation is not supported')
            return null;
        }
    }
</script>
