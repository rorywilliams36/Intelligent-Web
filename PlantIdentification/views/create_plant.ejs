<!DOCTYPE html>
<html>
    <head>
        <%- include('./partial/head.ejs'); %>
        <title><% title %></title>

    <header>
        <%- include('./partial/header.ejs'); %>
    </header>

    <body>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
        <form class="card col-md-6 mb-5 mx-auto">
            <div class="form-row">
                <div class="form-group">
                    <label for="inputPlantName">Plant Name</label>
                    <input type="text" class="form-control" id="inputPlantName" placeholder="Plant Name">
                </div>
            </div>
            <div class="form-group">
                <label for="inputAddress">Location Found</label>
                <input type="text" class="form-control" id="inputAddress" placeholder="Sheffield">
            </div>
            <div class="form-group">
                <label for="inputDate">Date Seen</label>
                <input type="text" class="form-control" id="inputDate" placeholder="YYYY-MM-DD">
            </div>
            <div class="form-group col-md-6">
                <label for="inputSize">Size</label>
                <input type="number" class="form-control" id="inputSize" placeholder="Size">
            </div>
            <div class="form-group">
                <div class="form-check btn-outline-dark">
                    <input class="form-check-input" type="checkbox" id="flowers">
                    <label class="form-check-label" for="flowers">
                        Flowers?
                    </label>
                </div>
            </div>
            <div class="form-group">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="leaves">
                    <label class="form-check-label" for="leaves">
                        Leaves?
                    </label>
                </div>
            </div>
            <div class="form-group">
                <select class="form-select" aria-label="Seeds and Fruits Select">
                    <option selected>Seeds/Fruits</option>
                    <option value="1">Seeds and Fruits</option>
                    <option value="2">Fruits</option>
                    <option value="3">Seeds</option>
                    <option value="4">None</option>
                </select>
            </div>
            <div class="form-group">
                <select class="form-select" aria-label="Sun Exposure Select">
                    <option selected>Sun Exposure</option>
                    <option value="1">Full Sun</option>
                    <option value="2">Partial Shade</option>
                    <option value="3">Full Shade</option>
                    <option value="4">N/a</option>
                </select>
            </div>
            <div class="form-group">
                <label for="description">Description</label>
                <textarea class="form-control" id="description" rows="3"></textarea>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="gridCheck">
                <label class="form-check-label" for="gridCheck">
                    Solved
                </label>
            </div>
            <button type="submit" class="btn btn-primary">Submit Plant</button>
        </form>
    </body>

    <footer>
        <%- include('./partial/footer.ejs'); %>
    </footer>
</html>
